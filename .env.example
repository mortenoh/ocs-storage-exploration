# Backend selection: file, memory or s3
OCS_STORAGE_BACKEND=file

# Filesystem backend
OCS_STORAGE_DATA_DIRECTORY=data

# Key prefix every dataset is stored below
OCS_STORAGE_BASE_PREFIX=ocs

# Directories the ingest endpoints may read local files from. A path outside them
# is refused with 400 before anything is opened. Defaults to the two below.
# OCS_STORAGE_INGEST_ROOTS=["samples","data"]

# Guards
OCS_STORAGE_MAX_UNQUALIFIED_FEATURE_COUNT=50000
OCS_STORAGE_MAX_QUERY_CELL_COUNT=50000000
OCS_STORAGE_PARQUET_ROW_GROUP_SIZE=65536

# Bounds of the async facade: how many blocking engine calls may run at once, and
# how long one may wait for a slot and run before the request answers 504.
OCS_STORAGE_MAX_CONCURRENT_STORAGE_OPERATIONS=16
OCS_STORAGE_STORAGE_OPERATION_TIMEOUT_SECONDS=180

# Server
OCS_STORAGE_HOST=127.0.0.1
OCS_STORAGE_PORT=8000
OCS_STORAGE_LOG_LEVEL=info
OCS_STORAGE_RELOAD=false

# S3 backend, matching the rustfs service in compose.yml
# OCS_STORAGE_BACKEND=s3
# OCS_STORAGE_S3__BUCKET=ocs-storage-exploration
# OCS_STORAGE_S3__PREFIX=ocs
# OCS_STORAGE_S3__REGION=us-east-1
# OCS_STORAGE_S3__ENDPOINT_URL=http://127.0.0.1:9000
# OCS_STORAGE_S3__ALLOW_HTTP=true
# OCS_STORAGE_S3__FORCE_PATH_STYLE=true
# OCS_STORAGE_S3__ACCESS_KEY_ID=rustfsadmin
# OCS_STORAGE_S3__SECRET_ACCESS_KEY=rustfsadmin

# Client bounds, translated once into obstore, Icechunk and pyarrow. The retry
# budget of one request is REQUEST_TIMEOUT * (MAX_RETRIES + 1) + BACKOFF * MAX_RETRIES.
# OCS_STORAGE_S3__CONNECT_TIMEOUT_SECONDS=5
# OCS_STORAGE_S3__REQUEST_TIMEOUT_SECONDS=30
# OCS_STORAGE_S3__MAX_RETRIES=3
# OCS_STORAGE_S3__RETRY_BACKOFF_SECONDS=0.5

# Credentials the rustfs container starts with; they must match the pair above
# RUSTFS_ACCESS_KEY=rustfsadmin
# RUSTFS_SECRET_KEY=rustfsadmin

# rustfs is started by `make test-s3` (which stops it again) and by the s3
# compose profile, `make docker-run-s3`. Inside compose the endpoint is
# http://rustfs:9000; from the host it is http://127.0.0.1:9000.
